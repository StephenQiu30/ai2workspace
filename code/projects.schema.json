{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2workspace.local/schemas/projects.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "binding", "responsibility"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "binding": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
